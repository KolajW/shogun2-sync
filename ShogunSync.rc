PRODUCTVERSION 0,1,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KolajW"
            VALUE "FileDescription", "Shogun-Sync GUI Launcher"
            VALUE "FileVersion", "0.1.3.0"
            VALUE "InternalName", "ShogunSync"
            VALUE "LegalCopyright", "Copyright (C) 2026 KolajW. GNU GPL v2.0."
            VALUE "OriginalFilename", "ShogunSync.exe"
            VALUE "ProductName", "Shogun-Sync"
            VALUE "ProductVersion", "0.1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "app.manifest"
